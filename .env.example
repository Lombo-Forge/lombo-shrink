# Copy to .env and edit. Every setting is optional unless a comment says otherwise.
# Safe by default: nothing is encoded, swapped or deleted until DRY_RUN=false.
LOMBO_SHRINK_DRY_RUN=true

# ---- main PC (with a discrete graphics card): find, encode, report
# The library as this machine sees it (a network drive or mount on the PC). Required for candidates, plan and run.
LOMBO_SHRINK_LIBRARY_DIR=/mnt/media
# Where converted files are written. Must not be inside the library.
LOMBO_SHRINK_OUT_DIR=./converted
# ffmpeg and ffprobe (full paths if they are not on PATH).
LOMBO_SHRINK_FFMPEG=ffmpeg
LOMBO_SHRINK_FFPROBE=ffprobe
# auto, nvenc (NVIDIA), amf (AMD), qsv (Intel), videotoolbox (macOS) or x265 (processor only, slow).
LOMBO_SHRINK_ENCODER=auto
# Constant quality: higher is smaller and harsher. 26 was measured; MAX_CQ is the highest value allowed.
LOMBO_SHRINK_CQ=26
LOMBO_SHRINK_MAX_CQ=28
# true = pick the quality level for each file instead of using CQ: short samples are encoded and scored against the
# source (VMAF), and the highest level from 22 to MAX_CQ that still looks like it wins. Costs a few minutes a file.
# Needs an ffmpeg with the libvmaf filter; without one, or if scoring fails, CQ is used.
LOMBO_SHRINK_QUALITY_PROBE=false
# That ffmpeg, when it is not the one above. Empty = FFMPEG.
LOMBO_SHRINK_VMAF_FFMPEG=
# Accept a result only if it is at least this many percent smaller.
LOMBO_SHRINK_MIN_SAVING_PCT=20
# Skip sources below this many bits per pixel per frame (0 = off); they are already starved of bitrate.
LOMBO_SHRINK_MIN_BPP=0.08
# Always leave this much free space in OUT_DIR.
LOMBO_SHRINK_SPARE_GB=20
# Stop after this many GB of output (0 = no limit).
LOMBO_SHRINK_MAX_GB=0
# Stop after this many files in one run (0 = no limit).
LOMBO_SHRINK_LIMIT=0
# Kill an encode whose output file does not grow for this many minutes.
LOMBO_SHRINK_STALL_MINUTES=5
# Also convert H.265 sources (only for files you picked by hand).
LOMBO_SHRINK_ALLOW_HEVC=false
# Extra ffmpeg encoder arguments, added after the built-in ones.
LOMBO_SHRINK_EXTRA_ENCODER_ARGS=
# Leave out files that a torrent still seeds (a hard link count of 2 or more).
LOMBO_SHRINK_SKIP_HARDLINKED=true
# Optional. A text file of titles to leave alone, one library path or folder per line (movies/Old Film (1999)), e.g.
# ones about to be deleted. Blank lines and # comments are ignored. Applies to candidates, plan and run without --list.
LOMBO_SHRINK_SKIP_FILE=

# ---- main PC to server: ship each accepted file (key login, no password prompts)
# user@host of the server. Empty means files stay in OUT_DIR until you ship them.
LOMBO_SHRINK_SHIP_TARGET=
LOMBO_SHRINK_SSH_COMMAND=ssh
LOMBO_SHRINK_SCP_COMMAND=scp
# How to start lombo-shrink on the server, and its staging folder (same as STAGE_DIR there).
LOMBO_SHRINK_REMOTE_COMMAND=lombo-shrink
LOMBO_SHRINK_REMOTE_STAGE_DIR=lombo-shrink-staging

# ---- server: swap converted files into the library (the dangerous part: needs DRY_RUN=false)
# Staging folder where the PC drops files.
LOMBO_SHRINK_STAGE_DIR=/var/lib/lombo-shrink/staging
# With mergerfs: one library folder per disk, separated by colons, so the new file lands on the same disk
# as the original. Empty means LIBRARY_DIR itself.
LOMBO_SHRINK_BRANCHES=
# Move originals to a .lombo-shrink-holding folder inside the library instead of deleting them. Nothing clears it.
LOMBO_SHRINK_KEEP_ORIGINALS=false
# Keep this much free on the disk after the swap.
LOMBO_SHRINK_MARGIN_GB=20
# Optional. Folders in BRANCHES that keep more free than that, e.g. a boot disk: /mnt/boot-ssd/library=250
# (comma separated). The larger of the two numbers counts.
LOMBO_SHRINK_BRANCH_MARGIN_GB=
# Allow swap --apply only while `lombo-shrink session open` is active (it expires by itself).
LOMBO_SHRINK_REQUIRE_SESSION=true
LOMBO_SHRINK_SESSION_FILE=/var/lib/lombo-shrink/staging/session.json
# Optional command to run once after a real swap (for example to rescan the title in Sonarr or Radarr). It is started
# without a shell, with the swapped paths as JSON in the environment variable LOMBO_SHRINK_SWAPPED_JSON. A failure
# is a note on the result, never a failed swap. Never runs in a dry run. Empty means none.
LOMBO_SHRINK_POST_SWAP_COMMAND=

# ---- optional
# Jellyfin is only asked to rescan after a swap, and checked by doctor.
LOMBO_SHRINK_JELLYFIN_URL=
LOMBO_SHRINK_JELLYFIN_API_KEY=changeme
# Alerts when a run ends (Discord, Slack or compatible).
LOMBO_SHRINK_WEBHOOK_URL=
